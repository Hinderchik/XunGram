[Desktop Entry]
Name=XunGram
Comment=Telegram client with plugin system
TryExec=XunGram
Exec=XunGram -- %U
Icon=org.telegram.desktop
Terminal=false
StartupWMClass=XunGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=tg;chat;im;messaging;messenger;sms;xungram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=XunGram -quit
Name=Quit XunGram
Icon=application-exit
